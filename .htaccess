# Deny all private resources, before any other rewrite.
RewriteEngine On
RewriteRule "(^|/)(\.|database(?:/|$)|tools(?:/|$)|tests(?:/|$))" - [F,L]
RewriteRule "\.(sql|bak|log|ini|env|md|docx?)(\.|$)" - [F,L,NC]
RewriteRule "^(config|app_security)\.php$" - [F,L,NC]
RewriteRule "^(test_|_test_|debug_|insert_demo|create_and_associate|associate_|migrate_|ripristina_|update_activity|process\.php)" - [F,L,NC]
# Open Day Virtuale - Configurazione Apache

# Forza HTTPS in produzione (InfinityFree / hosting con SSL). Su XAMPP localhost evitare redirect HTTPS.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost(?::[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(?::[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Protezione file sensibili
<FilesMatch "^(config\.php|database\.sql|database_import\.sql|database_import_FIXED\.sql|config_hosting\.php\.example|config_infinityfree\.php|config_INFINITYFREE_PRONTO\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protezione directory
Options -Indexes

# Compressione GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache browser
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Pagina di errore personalizzata (opzionale)
# ErrorDocument 404 /404.php
# ErrorDocument 500 /500.php
